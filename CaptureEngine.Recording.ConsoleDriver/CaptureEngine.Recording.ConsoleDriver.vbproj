<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>CaptureEngine.Recording.ConsoleDriver</RootNamespace>
    <AssemblyName>CaptureEngine.Recording.ConsoleDriver</AssemblyName>
    <!-- Same Windows TFM as Ddagrab (DXGI dependency flows transitively). -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <OptionStrict>On</OptionStrict>
    <OptionExplicit>On</OptionExplicit>
    <OptionInfer>On</OptionInfer>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <Description>CaptureEngine.Recording.ConsoleDriver — Phase 12a-5b integration harness (Ddagrab + NvencEncoderBackend runtime gate)</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- Production contracts. -->
    <ProjectReference Include="..\CaptureEngine.Video\CaptureEngine.Video.vbproj" />
    <ProjectReference Include="..\CaptureEngine\CaptureEngine.vbproj" />
    <!-- Concrete backends under test. -->
    <ProjectReference Include="..\CaptureEngine.Video.Ddagrab\CaptureEngine.Video.Ddagrab.vbproj" />
    <ProjectReference Include="..\CaptureEngine.Encoder.Nvenc\CaptureEngine.Encoder.Nvenc.vbproj" />
    <!-- Foundation encoder contract (for IEncoderBackend + EncodedPacket). -->
    <ProjectReference Include="..\CaptureEngine.Encoder\CaptureEngine.Encoder.vbproj" />
  </ItemGroup>

</Project>
