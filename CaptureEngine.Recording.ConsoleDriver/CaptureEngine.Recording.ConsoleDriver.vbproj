<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>CaptureEngine.Recording.ConsoleDriver</RootNamespace>
    <AssemblyName>CaptureEngine.Recording.ConsoleDriver</AssemblyName>
    <TargetFramework>net8.0-windows</TargetFramework>
    <OptionStrict>On</OptionStrict>
    <OptionExplicit>On</OptionExplicit>
    <OptionInfer>On</OptionInfer>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <Description>CaptureEngine.Recording.ConsoleDriver — Phase 12a-5 orchestration test (2-session MP4 lifecycle)</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- Recording orchestration (transitively pulls in all backends) -->
    <ProjectReference Include="..\CaptureEngine.Recording\CaptureEngine.Recording.vbproj" />
    <!-- Foundation (for EngineLogger — used directly in Program.vb) -->
    <ProjectReference Include="..\CaptureEngine\CaptureEngine.vbproj" />
  </ItemGroup>

</Project>
