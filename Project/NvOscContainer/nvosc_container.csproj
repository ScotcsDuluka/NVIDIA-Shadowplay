    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>nvosc_container</AssemblyName>
    <RootNamespace>NvOscContainer</RootNamespace>
    <OutputPath>C:\My Project\NVIDIA-Shadowplay\build\NVIDIA ShadowPlay\NvOscContainer\</OutputPath>
