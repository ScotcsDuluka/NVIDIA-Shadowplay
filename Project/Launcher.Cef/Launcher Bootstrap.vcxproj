<?xml version="1.0" encoding="utf-8"?>
<!--
  Launcher Bootstrap.vcxproj - Launcher CEF lane thin bootstrap.
  Produces Launcher.exe (the product-root double-click entry, replacing
  the WinForm Launcher). Loads NvOverlay\Cef\Launcher.dll and calls its
  NvLauncherCefMain export, which implements the full CEF process split:
  subprocess relaunches of this exe (renderer/gpu/utility) re-enter the
  same export and are handled by CefExecuteProcess. The body DLL sits in
  the shared CEF runtime slot ("ลงที่เดียวกับ osc") so libcef.dll,
  cef.pak and locales\ are used once from NvOverlay\Cef.
-->
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- BL-1 C++ lane: _Bl1CppStamp (root Directory.Build.targets) regenerates
       src/bl1_version.h with the resolved product version before ResourceCompile. -->
  <PropertyGroup>
    <Bl1CppVersionPrefix>LAUNCHER</Bl1CppVersionPrefix>
  </PropertyGroup>
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <ProjectName>Launcher Bootstrap</ProjectName>
    <WindowsTargetPlatformVersion>10.0.26100.0</WindowsTargetPlatformVersion>
    <ImportDirectoryBuildProps>false</ImportDirectoryBuildProps>
    <ImportDirectoryBuildTargets>false</ImportDirectoryBuildTargets>
    <ProjectGuid>{B3E9F0A1-5D26-47C4-8E7B-90A1C2D3E4F5}</ProjectGuid>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'" Label="Configuration">
    <ConfigurationType>Application</ConfigurationType>
    <PlatformToolset>v145</PlatformToolset>
    <CharacterSet>Unicode</CharacterSet>
    <WholeProgramOptimization>false</WholeProgramOptimization>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'" Label="Configuration">
    <ConfigurationType>Application</ConfigurationType>
    <PlatformToolset>v145</PlatformToolset>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <PropertyGroup>
    <CefSdk Condition="'$(CefSdk)'==''">C:\My Project\cef-sdk\cef73\</CefSdk>
    <OutDir>$(ProjectDir)bin\$(Platform)\$(Configuration)\</OutDir>
    <IntDir>$(ProjectDir)obj\$(Platform)\$(Configuration)\$(ProjectName)\</IntDir>
    <TargetName>Launcher</TargetName>
    <LinkIncremental>false</LinkIncremental>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <WarningLevel>Level4</WarningLevel>
      <TreatWarningAsError>false</TreatWarningAsError>
      <DebugInformationFormat>ProgramDatabase</DebugInformationFormat>
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
      <RuntimeLibrary Condition="'$(Configuration)'=='Release'">MultiThreaded</RuntimeLibrary>
      <RuntimeLibrary Condition="'$(Configuration)'=='Debug'">MultiThreadedDebug</RuntimeLibrary>
      <Optimization Condition="'$(Configuration)'=='Release'">MaxSpeed</Optimization>
      <PreprocessorDefinitions Condition="'$(Configuration)'=='Release'">NDEBUG;_NDEBUG;LAUNCHER_TARGET_EXE=1;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <Link>
      <SubSystem>Windows</SubSystem>
      <AdditionalDependencies>user32.lib;kernel32.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
    <ResourceCompile>
      <PreprocessorDefinitions>LAUNCHER_TARGET_EXE=1;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ResourceCompile>
    <Manifest>
      <AdditionalManifestFiles>$(ProjectDir)src\app.manifest;%(AdditionalManifestFiles)</AdditionalManifestFiles>
      <EnableDpiAwareness>false</EnableDpiAwareness>
    </Manifest>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClCompile Include="src\bootstrap.cpp" />
  </ItemGroup>
  <ItemGroup>
    <ResourceCompile Include="src\version.rc" />
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <!-- BL-1 C++ lane: vcxproj does not auto-import Directory.Build.* —
       explicit import gives the native hosts the same version contract. -->
  <Import Project="$(MSBuildProjectDirectory)\..\..\Build\Build-Config\bl1-cpp.targets" Condition="Exists('$(MSBuildProjectDirectory)\..\..\Build\Build-Config\bl1-cpp.targets')" />
</Project>
