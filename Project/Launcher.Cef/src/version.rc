// version.rc - Launcher CEF lane version stamping (Launcher.exe at the
// root slot / Launcher.dll in the NvOverlay\Cef shared runtime slot).
// Version convention follows the sibling CEF lane
// (3.41.<build counter>.61; Overlay\build.txt currently 3792).
#include <windows.h>

#ifdef LAUNCHER_TARGET_EXE
IDI_ICON1 ICON "..\\Assets\\NVIDIA ShadowPlay.ico"
#endif

#define LAUNCHER_FILEVERSION 3,41,3792,61
#define LAUNCHER_FILEVERSION_STR "3.41.3792.61\0"

// BL-1: generated bl1_version.h overrides the defaults above on every build
// (Build\Build-Config\bl1-cpp.targets - hardcore / per-project aware).
#include "bl1_version.h"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION LAUNCHER_FILEVERSION
 PRODUCTVERSION LAUNCHER_FILEVERSION
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x40004L
#ifdef LAUNCHER_TARGET_EXE
 FILETYPE 0x1L
#else
 FILETYPE 0x2L
#endif
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "ShadowPlay rebuild"
            VALUE "FileDescription", "NVIDIA ShadowPlay Launcher (CEF host)"
            VALUE "FileVersion", LAUNCHER_FILEVERSION_STR
            VALUE "InternalName", "Launcher"
            VALUE "LegalCopyright", "ShadowPlay rebuild project (reference: NVIDIA GFE 3.28 owner layout)"
#ifdef LAUNCHER_TARGET_EXE
            VALUE "OriginalFilename", "Launcher.exe"
#else
            VALUE "OriginalFilename", "Launcher.dll"
#endif
            VALUE "ProductName", "NVIDIA ShadowPlay"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
