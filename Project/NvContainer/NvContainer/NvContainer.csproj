<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- NvContainer owns NVIDIA OSC.exe, NVIDIA Web Helper.exe, and nvsphelper.exe.
         NvCapture.exe is intentionally not started by this process manager yet. -->
    <OutputType>WinExe</OutputType>
    <AssemblyName>NvContainer</AssemblyName>
    <RootNamespace>NvContainer</RootNamespace>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.26100.0</SupportedOSPlatformVersion>
    <Platforms>AnyCPU;x64</Platforms>
    <ApplicationIcon>NVIDIA ShadowPlay.ico</ApplicationIcon>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

</Project>
