<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- WinExe: no console at all; "showConsole": true allocates one -->
    <OutputType>WinExe</OutputType>
    <!-- OWNER: NvContainer is the NEW root/control-plane authority (replaces the
         legacy API-hub role). It OWNS nvsphelper64.exe (capture/engine
         worker) and nothing else: NVIDIA Web Helper.exe supervises only the
         overlay/WebView family and stays outside this boundary.
         Responsibilities: TCP/IPC authority, process spawn, supervision,
         health monitoring, restart/lifecycle, state coordination, worker
         orchestration. -->
    <AssemblyName>NVIDIA Container</AssemblyName>
    <RootNamespace>NvContainer</RootNamespace>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.26100.0</SupportedOSPlatformVersion>
    <Platforms>AnyCPU;x64</Platforms>
    <!-- OWNER icon mandate: every new executable project uses the canonical
         Overlay icon (single source of truth in Assets\). -->
    <ApplicationIcon>..\..\NvOverlay\Cef\NvShim\Assets\NVIDIA ShadowPlay.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="..\..\NvOverlay\Cef\NvShim\Assets\NVIDIA ShadowPlay.ico" Link="NVIDIA ShadowPlay.ico" />
  </ItemGroup>

</Project>
