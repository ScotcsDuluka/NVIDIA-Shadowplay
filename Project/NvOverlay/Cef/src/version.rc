// version.rc - CEF lane version stamping (NVIDIA Share.exe / NVIDIA Share.dll).
// Version convention follows the sibling role instances
// (3.41.<build counter>.61; Overlay\build.txt currently 3792).
#include <windows.h>

#ifdef SHARE_TARGET_EXE
IDI_ICON1 ICON "..\\NvShim\\Assets\\NVIDIA ShadowPlay.ico"
#endif

#define SHARE_FILEVERSION 3,41,3792,61
#define SHARE_FILEVERSION_STR "3.41.3792.61\0"

// BL-1: generated bl1_version.h overrides the defaults above on every build
// (Build\Build-Config\bl1-cpp.targets - hardcore / per-project aware).
#include "bl1_version.h"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION SHARE_FILEVERSION
 PRODUCTVERSION SHARE_FILEVERSION
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x40004L
#ifdef SHARE_TARGET_EXE
 FILETYPE 0x1L
#else
 FILETYPE 0x2L
#endif
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "ShadowPlay rebuild"
            VALUE "FileDescription", "NVIDIA Share (CEF OSC host)"
            VALUE "FileVersion", SHARE_FILEVERSION_STR
            VALUE "InternalName", "NVIDIA Share"
            VALUE "LegalCopyright", "ShadowPlay rebuild project (reference: NVIDIA GFE 3.28 owner layout)"
#ifdef SHARE_TARGET_EXE
            VALUE "OriginalFilename", "NVIDIA Share.exe"
#else
            VALUE "OriginalFilename", "NVIDIA Share.dll"
#endif
            VALUE "ProductName", "NVIDIA Share"
            VALUE "ProductVersion", SHARE_FILEVERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
