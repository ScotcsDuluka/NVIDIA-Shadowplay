<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>CaptureEngine.Recording.Tests</RootNamespace>
    <TargetFramework>net10.0</TargetFramework>
    <OptionStrict>On</OptionStrict>
    <OptionExplicit>On</OptionExplicit>
    <OptionInfer>On</OptionInfer>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>CaptureEngine.Recording.Tests</AssemblyName>
    <Description>Phase 12b tests — SyncMath + WavSidecarWriter units + real-ffmpeg A/V sync runtime validation (runs on Windows AND Linux)</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CaptureEngine.FFmpegBackend\CaptureEngine.FFmpegBackend.vbproj" />
    <!-- DisposerTests: the GPU frame disposer links its production source
         below; the contract types it consumes live in CaptureEngine.Video
         (pure net10.0 — no D3D11 dependency at this layer). -->
    <ProjectReference Include="..\CaptureEngine.Video\CaptureEngine.Video.vbproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Real production file, LINKED (not copied) — the disposer regression
         tests run on the SAME source the recording engine compiles. -->
    <Compile Include="..\CaptureEngine.Recording\DeferredVideoFrameDisposer.vb" Link="DeferredVideoFrameDisposer.vb" />
  </ItemGroup>

</Project>
