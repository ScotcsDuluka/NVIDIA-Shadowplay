*.log
output.txt
spike_output.md

# Local-only artifacts (prevent history bloat accidents — see 2026-08 'heavyweight artifacts' cleanup)
# Note: FFmpeg binaries ship via Overlay/API-Core (ignored dir), never as tracked archives
*.lnk
*.mcworld
*.zip
*.7z
*.msi
Video_Codec_Interface_13.1.15/
test_*.zip

# Test/spike run outputs
spikes/**/out/
spikes/**/logs/
**/TestResults/
**/*.trx

# App/runtime data that should stay local
Overlay/build.txt
Overlay/NVIDIA_Shadowplay_Data/
Overlay/API-Core/

# wrangler files
.wrangler
.dev.vars*
!.dev.vars.example
.env*
!.env.example
dist/
scripts/apphost_test/out*
scripts/apphost_test/bin/
scripts/apphost_test/obj/
