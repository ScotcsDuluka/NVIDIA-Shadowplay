Imports System.IO
Imports System.Runtime.InteropServices

Public Class Form1
    <DllImport("user32.dll", SetLastError:=True)>
    Private Shared Function SetWindowLong(hWnd As IntPtr, nIndex As Integer, dwNewLong As Integer) As Integer
    End Function

    <DllImport("user32.dll", SetLastError:=True)>
    Private Shared Function GetWindowLong(hWnd As IntPtr, nIndex As Integer) As Integer
    End Function

    Private Const GWL_EXSTYLE As Integer = -20
    Private Const WS_EX_TOOLWINDOW As Integer = &H80
    Private Const WS_EX_APPWINDOW As Integer = &H40000

    Private Sub HideFromAltTab()
        If Me.IsHandleCreated Then
            Dim style As Integer = GetWindowLong(Me.Handle, GWL_EXSTYLE)
            Dim newStyle As Integer = (style Or WS_EX_TOOLWINDOW) And Not WS_EX_APPWINDOW
            SetWindowLong(Me.Handle, GWL_EXSTYLE, newStyle)
        End If
    End Sub

    Private Sub ShowNotification(iconText As String, messageText As String, showImage As Boolean)
        ' Ensure UI updates run on the UI thread
        If Me.InvokeRequired Then
            Me.Invoke(Sub() ShowNotification(iconText, messageText, showImage))
            Return
        End If

        Try
            Notifier.Show()
        Catch
            ' ignore if already shown or not available
        End Try

        Try
            Notifier_Sub.icon_n.Text = iconText
            Notifier_Sub.text_n.Text = messageText
            Notifier_Sub.PictureBox1.Visible = showImage
            Notifier_Sub.TopMost = True
            Notifier_Sub.Show()
        Catch
            ' If controls/forms are not available, fail silently
        End Try
    End Sub

    Private Sub Button1_Click(sender As Object, e As EventArgs) Handles Button1.Click
        Notifier.Show()
        Notifier_Sub.icon_n.Text = ""
        Notifier_Sub.text_n.Text = "Press Alt + Z to use Shadowplay Experience in-game overlay"
        Notifier_Sub.PictureBox1.Visible = True
    End Sub

    Private Sub RUN_API_Tick(sender As Object, e As EventArgs) Handles RUN_API.Tick

        Notifier_Sub.TopMost = True
        Dim checks As New Dictionary(Of String, (String, Boolean, String)) From {
    {"game_n-api", ("Press Alt + Z to use Shadowplay Experience in-game overlay", True, "")},
    {"notuse-api", ("This feature not ready", False, "")},
    {"notworkgpu-api", ("Game Filter Not working Current GPU", False, "")},
    {"Screenshot-api", ("Screenshot has been saved to Gallery.", False, "")},
    {"validsavepath-api", ("Please select a valid save path for screenshots.", False, "")},
    {"recording_started-api", ("Recording has started", False, "")},
    {"recording_saved-api", ("Recording has been saved", False, "")},
    {"recording_started_space-api", ("Recording has started ", False, "")},
    {"recording_saved_space-api", ("Recording has been saved ", False, "")},
    {"replay_error-api", ("Erorr to saved last {{replay_save}}.", False, "")},
    {"replay_turn_on-api", ("Turn on instant replay to save the last.", False, "")},
    {"instant_replay_off-api", ("Instant Replay is now off", False, "")},
    {"instant_replay_on-api", ("Instant Replay is now on", False, "")},
    {"photo_mode_error-api", ("Photo Mode Not working Current GPU", False, "")},
    {"feature_not_ready-api", ("This feature not ready", False, "")},
    {"extension_not_found-api", ("Extension not found", False, "")},
    {"error_confirm-api", ("Erorr to confirm account.", False, "")},
    {"saved_last_15-api", ("Saved last 15 seconds.", False, "")},
    {"notifier_open-api", ("Notifier is Open.", False, "")},
    {"notifier_not_using-api", ("Notifier not using.", False, "")},
    {"app_closed-api", ("NVIDIA Shadowplay™ app is closed.", False, "")},
    {"shared_close-api", ("NVIDIA Shared Close", False, "")},
    {"update_available-api", ("New Version Shadowplay™ Update available", False, "")},
    {"privacy-api", ("Privacy control capture has off. Turn on to use", False, "")},
    {"version_latest-api", ("Version Shadowplay™ is latest.", False, "")},
    {"error_general-api", ("Erorr.", False, "")}
}

        For Each kvp In checks
            Dim filePath = Path.Combine(Application.StartupPath, "NVIDIA_Shadowplay_Data", kvp.Key)

            If My.Computer.FileSystem.FileExists(filePath) Then
                If My.Computer.FileSystem.FileExists(Application.StartupPath & "NVIDIA_Shadowplay_Data\py") Then

                    Notifier.Show()
                    Notifier_Sub.icon_n.Font = New Font(Notifier_Sub.icon_n.Font.FontFamily, 40)
                    Notifier_Sub.icon_n.ForeColor = Color.White
                    Notifier_Sub.icon_n.Text = kvp.Value.Item3
                    Notifier_Sub.text_n.Text = kvp.Value.Item1
                    Notifier_Sub.PictureBox1.Visible = kvp.Value.Item2

                    File.Delete(filePath)
                Else
                    If kvp.Value.Item3 = "" Then
                        File.Delete(filePath)
                        Notifier.Show()
                        Notifier_Sub.icon_n.Font = New Font(Notifier_Sub.icon_n.Font.FontFamily, 40)
                        Notifier_Sub.icon_n.ForeColor = Color.White
                        Notifier_Sub.icon_n.Text = kvp.Value.Item3
                        Notifier_Sub.text_n.Text = kvp.Value.Item1
                        Notifier_Sub.PictureBox1.Visible = kvp.Value.Item2
                    Else
                        File.Delete(filePath)
                        Notifier.Show()
                        Notifier_Sub.icon_n.Font = New Font(Notifier_Sub.icon_n.Font.FontFamily, 40)
                        Notifier_Sub.icon_n.ForeColor = Color.White
                        Notifier_Sub.icon_n.Text = ""
                        Notifier_Sub.text_n.Text = "Privacy control capture has off. Turn on to use"
                        Notifier_Sub.PictureBox1.Visible = False
                    End If

                End If
            End If
        Next
    End Sub
    Private Sub SafeDelete(path As String)

        For i As Integer = 0 To 5
            Try
                If File.Exists(path) Then
                    File.Delete(path)
                End If
                Exit Sub
            Catch
                Threading.Thread.Sleep(50)
            End Try
        Next

    End Sub
    Private Sub Button2_Click(sender As Object, e As EventArgs) Handles Button2.Click
        Notifier_Sub.Show()
    End Sub

    Private Sub Form1_Shown(sender As Object, e As EventArgs) Handles Me.Shown
        HideFromAltTab()
    End Sub
End Class
