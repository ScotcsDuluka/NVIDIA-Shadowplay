<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace></RootNamespace>
    <TargetFramework>net8.0-windows</TargetFramework>
    <OptionStrict>On</OptionStrict>
    <OptionExplicit>On</OptionExplicit>
    <OptionInfer>On</OptionInfer>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <AssemblyName>CaptureEngine.Recording</AssemblyName>
    <Description>CaptureEngine.Recording — Phase 12a-5 orchestration (RecordingEngine + CaptureSession)</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- Foundation -->
    <ProjectReference Include="..\CaptureEngine\CaptureEngine.vbproj" />
    <!-- Video contract + ID3D11VideoFrame -->
    <ProjectReference Include="..\CaptureEngine.Video\CaptureEngine.Video.vbproj" />
    <!-- DdagrabBackend (video capture) -->
    <ProjectReference Include="..\CaptureEngine.Video.Ddagrab\CaptureEngine.Video.Ddagrab.vbproj" />
    <!-- Encoder contract (IEncoderBackend + EncodedPacket) -->
    <ProjectReference Include="..\CaptureEngine.Encoder\CaptureEngine.Encoder.vbproj" />
    <!-- NvencEncoderBackend (H.264 encoding) -->
    <ProjectReference Include="..\CaptureEngine.Encoder.Nvenc\CaptureEngine.Encoder.Nvenc.vbproj" />
    <!-- FFmpeg stack (MuxCoordinator + FFmpegProcessHost) -->
    <ProjectReference Include="..\CaptureEngine.FFmpegBackend\CaptureEngine.FFmpegBackend.vbproj" />
    <!-- P13.2: position-aware WASAPI capture (direct COM interop, zero deps) -->
    <ProjectReference Include="..\CaptureEngine.Audio.Wasapi\CaptureEngine.Audio.Wasapi.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- NAudio for WASAPI loopback audio capture (same as spike Phase 10) -->
    <PackageReference Include="NAudio.Wasapi" Version="2.3.0" />
  </ItemGroup>

</Project>
