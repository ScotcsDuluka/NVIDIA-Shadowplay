<Project Sdk="Microsoft.NET.Sdk">

  <!--
  Gallery.Video — Gallery playback engine (NEW domain, 2026-09-10).

  DESIGN CONTRACT (docs/GALLERY-VIDEO-PLAYBACK-DESIGN-2026-09-10.md):
    - Playback of files produced by the capture regimes. NO dependency on any
      CaptureEngine.* project (playback lifecycle is separate from recording).
    - The only shared source is Common/FFmpegLocator.vb via the repo's
      link-compile convention (Common has no project file by design).
    - FFmpeg/ffprobe are consumed as SUBPROCESSES only — the repo has no
      library bindings and this prototype does not introduce any.
    - Windows-only surfaces (Vortice D3D11 present, NAudio WasapiOut) are
      compile-anywhere / runtime-gated so the whole engine builds on Linux CI
      (EnableWindowsTargeting, Directory.Build.props) and hardware behavior
      is proven only on the owner's machine (honest gates, never assumed).
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Repo convention: empty RootNamespace — namespaces come from file
         declarations alone (see CaptureEngine.Video.vbproj). -->
    <RootNamespace></RootNamespace>
    <AssemblyName>Gallery.Video</AssemblyName>
    <OptionStrict>On</OptionStrict>
    <OptionExplicit>On</OptionExplicit>
    <OptionInfer>On</OptionInfer>
    <OptionCompare>Binary</OptionCompare>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Repo convention: Common/*.vb are link-compiled, never referenced -->
    <Compile Include="..\Common\FFmpegLocator.vb" Link="FFmpegLocator.vb" />
  </ItemGroup>

  <ItemGroup>
    <!-- Audio output: the stack the product already ships (NAudio 2.3.0 in
         CaptureEngine.Recording + legacy Engine). WasapiOut = render side. -->
    <PackageReference Include="NAudio.Wasapi" Version="2.3.0" />
    <!-- D3D11 present path: same pinned Vortice versions as Ddagrab/NVENC. -->
    <PackageReference Include="Vortice.Direct3D11" Version="3.6.2" />
    <PackageReference Include="Vortice.DXGI" Version="3.6.2" />
  </ItemGroup>

</Project>
