<Project Sdk="Microsoft.NET.Sdk">

        <!-- NVIDIA Controls — designable WinForms control library.
             WHY THIS PROJECT EXISTS: a normal Overlay build sweeps its own bin
             into the OWNER's product tree (_ProductTreeBin in
             Directory.Build.targets): the app dll moves to Overlay\, all
             deps.json move to .NET Deployment\, package assemblies to their
             family folders. The app runs fine (AppLayout's AssemblyResolve
             handler supplies every cross-folder dependency at runtime), but
             the VS WinForms designer host cannot resolve that layout when it
             scans the app dll for toolbox items — so the Overlay project
             contributed ZERO controls to the Toolbox (while the Launcher,
             whose bin stays classic-flat, contributed 100%).

             A tiny class library stays classic-flat after every build, so the
             designer loads it and ToggleSwitch lands in the Toolbox under the
             "NVIDIA Controls" category.

             RootNamespace is NVIDIA_Share — the same namespace the control
             had while it compiled inside the Overlay — so every existing
             "ToggleSwitch" reference in the Overlay's Designer.vb/code-behind
             files resolves to NVIDIA_Share.ToggleSwitch unchanged. -->

        <PropertyGroup>
                <OutputType>Library</OutputType>
                <RootNamespace>NVIDIA_Share</RootNamespace>
                <UseWindowsForms>True</UseWindowsForms>
                <AssemblyName>NVIDIA Controls</AssemblyName>
                <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
                <Platforms>AnyCPU</Platforms>
                <GenerateDocumentationFile>False</GenerateDocumentationFile>
                <EnableWindowsTargeting>true</EnableWindowsTargeting>
                <!-- Match the Overlay's analyzer posture: the control compiled
                     there without WFO1000 (RunAnalyzersDuringBuild=False), so
                     the moved source must keep building identically. -->
                <RunAnalyzersDuringBuild>False</RunAnalyzersDuringBuild>
                <AnalysisLevel>6.0-minimum</AnalysisLevel>
                <NoWarn>$(NoWarn);41998,41999,42004,42016,42017,42018,42019,42020,42021,42022,42024,42025,42026,42029,42030,42031,42032,42036,42099,42104,42105,42106,42107,42108,42109,42353,42354,42355</NoWarn>
        </PropertyGroup>

</Project>
