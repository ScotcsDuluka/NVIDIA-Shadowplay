#Region "Form Events"

    Public Sub LoadAPIRECORD()
        Try
            Quality.Enabled = False
            HideFromAltTab()

            If cmbEncoder IsNot Nothing Then
                _cmbEncoderRef = cmbEncoder
            End If

            TrackBar_Replaylast.Minimum = 15
            TrackBar_Replaylast.Maximum = 1200
            TrackBar_Replaylast.SmallChange = 15
            TrackBar_Replaylast.LargeChange = 15
            TrackBar_Replaylast.TickFrequency = 15

            Dim savedSeconds As Integer = 60
            Try
                Dim settingValue As Object = My.Settings.ReplayDuration
                If settingValue IsNot Nothing AndAlso TypeOf settingValue Is Integer Then
                    savedSeconds = Math.Max(15, Math.Min(1200, CInt(settingValue)))
                End If
            Catch
            End Try

            savedSeconds = CInt(Math.Round(savedSeconds / 15.0) * 15)
            TrackBar_Replaylast.Value = savedSeconds
            UpdateBufferLabel(savedSeconds)

            SetupTrackBarDefaults()
            DetectHardware()

            Dim ffmpegPath As String = FindFFmpegPath()

            If Not String.IsNullOrEmpty(ffmpegPath) Then
                Task.Run(Sub()
                             Try
                                 ScreenRecorder.PreWarmFFmpeg(ffmpegPath)
                             Catch ex As Exception
                                 Debug.WriteLine("Pre-warm error: " & ex.Message)
                             End Try
                         End Sub)
            Else
                Debug.WriteLine("FFmpeg not found for pre-warm")
            End If

            PopulateEncoderDictionary()
            SelectSavedOrBestEncoder()

            LoadResolutionBox()
            LoadSettings()
            UpdateUIFromPreset()

            Quality.Enabled = True

        Catch ex As Exception
            Debug.WriteLine("Base_RecordingsSet_Load Error: " & ex.Message)
            Quality.Enabled = True
        End Try
    End Sub

    Private Function FindFFmpegPath() As String
        Dim possiblePaths As New List(Of String)()

        possiblePaths.Add(Path.Combine(Application.StartupPath, "api-core", "ffmpeg.exe"))
        possiblePaths.Add(Path.Combine(Application.StartupPath, "ffmpeg.exe"))
        possiblePaths.Add(Path.Combine(Application.StartupPath, "bin", "ffmpeg.exe"))

        Dim parentDir As DirectoryInfo = Directory.GetParent(Application.StartupPath)
        If parentDir IsNot Nothing Then
            possiblePaths.Add(Path.Combine(parentDir.FullName, "api-core", "ffmpeg.exe"))
            possiblePaths.Add(Path.Combine(parentDir.FullName, "ffmpeg.exe"))
        End If

        For Each testPath As String In possiblePaths
            If File.Exists(testPath) Then
                Debug.WriteLine("FFmpeg found at: " & testPath)
                Return testPath
            End If
        Next

        Try
            Dim pathEnv As String = Environment.GetEnvironmentVariable("PATH")
            If Not String.IsNullOrEmpty(pathEnv) Then
                For Each p As String In pathEnv.Split(";"c)
                    Dim testPath As String = Path.Combine(p.Trim(), "ffmpeg.exe")
                    If File.Exists(testPath) Then
                        Debug.WriteLine("FFmpeg found in PATH: " & testPath)
                        Return testPath
                    End If
                Next
            End If
        Catch
        End Try

        Debug.WriteLine("FFmpeg NOT found!")
        Return Nothing
    End Function

