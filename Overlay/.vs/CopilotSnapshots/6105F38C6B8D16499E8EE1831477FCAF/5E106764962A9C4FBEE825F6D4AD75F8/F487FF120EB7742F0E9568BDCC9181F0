    Private Sub SelectSavedOrBestEncoder()
        If cmbEncoder Is Nothing OrElse cmbEncoder.Items.Count = 0 Then Exit Sub

        If Not String.IsNullOrEmpty(My.Settings.EncoderNOW) Then
            Dim index As Integer = cmbEncoder.Items.IndexOf(My.Settings.EncoderNOW)
            If index >= 0 Then
                cmbEncoder.SelectedIndex = index
                Debug.WriteLine("Selected saved encoder: " & My.Settings.EncoderNOW)
                Return
            End If
        End If

        For i As Integer = 0 To cmbEncoder.Items.Count - 1
            Dim name As String = cmbEncoder.Items(i).ToString()
            If name.StartsWith("NVENC") OrElse name.StartsWith("QuickSync") OrElse name.StartsWith("AMF") Then
                cmbEncoder.SelectedIndex = i
                Debug.WriteLine("Selected GPU encoder: " & name)
                Return
            End If
        Next

        If cmbEncoder.Items.Count > 0 Then
            cmbEncoder.SelectedIndex = 0
        End If
    End Sub

