#Region "Hardware Detection"
    Private Sub DetectHardware()
        If _hardwareDetected Then Exit Sub

        SyncLock _hardwareLock
            If _hardwareDetected Then Exit Sub

            Try
                Using searcher As New ManagementObjectSearcher("SELECT * FROM Win32_VideoController")
                    For Each gpu As ManagementObject In searcher.Get()
                        Dim name As String = gpu("Name").ToString()
                        Dim nameLower As String = name.ToLower()

                        Debug.WriteLine("GPU Found: " & name)

                        If nameLower.Contains("nvidia") OrElse nameLower.Contains("geforce") OrElse
                           nameLower.Contains("quadro") OrElse nameLower.Contains("rtx") OrElse
                           nameLower.Contains("gtx") Then
                            _hasNvidia = True
                            Debug.WriteLine(" -> Detected as NVIDIA")
                        End If

                        If nameLower.Contains("intel") OrElse nameLower.Contains("uhd graphics") OrElse
                           nameLower.Contains("iris") OrElse nameLower.Contains("hd graphics") Then
                            _hasIntel = True
                            Debug.WriteLine(" -> Detected as Intel")
                        End If

                        If nameLower.Contains("amd") OrElse nameLower.Contains("radeon") OrElse
                           nameLower.Contains("rx ") OrElse nameLower.Contains("vega") OrElse
                           nameLower.Contains("rdna") Then
                            _hasAMD = True
                            Debug.WriteLine(" -> Detected as AMD")
                        End If
                    Next
                End Using

                If Not (_hasNvidia OrElse _hasIntel OrElse _hasAMD) Then
                    DetectHardwareViaDLL()
                End If

                _hardwareDetected = True

                Debug.WriteLine(String.Format("Hardware Detection Complete: NVIDIA={0}, Intel={1}, AMD={2}",
                    _hasNvidia, _hasIntel, _hasAMD))

            Catch ex As Exception
                Debug.WriteLine("DetectHardware WMI Error: " & ex.Message)

                Try
                    DetectHardwareViaDLL()
                Catch ex2 As Exception
                    Debug.WriteLine("DetectHardware DLL Error: " & ex2.Message)
                End Try

                _hardwareDetected = True
            End Try
        End SyncLock
    End Sub

    Private Sub DetectHardwareViaDLL()
        Try
            Dim systemPath As String = Environment.GetFolderPath(Environment.SpecialFolder.System)
            Dim programFiles As String = Environment.GetEnvironmentVariable("ProgramFiles")

            If Not _hasNvidia Then
                Dim nvidiaPaths As String() = {
                    Path.Combine(systemPath, "nvenc.dll"),
                    Path.Combine(systemPath, "nvcuda.dll"),
                    Path.Combine(systemPath, "nvapi64.dll"),
                    Path.Combine(programFiles, "NVIDIA Corporation\NVENC\nvenc.dll")
                }

                For Each p As String In nvidiaPaths
                    If File.Exists(p) Then
                        _hasNvidia = True
                        Debug.WriteLine("NVIDIA detected via DLL: " & p)
                        Exit For
                    End If
                Next
            End If

            If Not _hasIntel Then
                Dim intelPaths As String() = {
                    Path.Combine(systemPath, "mfxdrv64.dll"),
                    Path.Combine(systemPath, "libmfxhw64.dll"),
                    Path.Combine(programFiles, "Intel\Media SDK\libmfxhw64.dll")
                }

                For Each p As String In intelPaths
                    If File.Exists(p) Then
                        _hasIntel = True
                        Debug.WriteLine("Intel detected via DLL: " & p)
                        Exit For
                    End If
                Next
            End If

            If Not _hasAMD Then
                Dim amdPaths As String() = {
                    Path.Combine(systemPath, "amdocl64.dll"),
                    Path.Combine(systemPath, "atiadlxx.dll"),
                    Path.Combine(systemPath, "amfrt64.dll"),
                    Path.Combine(programFiles, "AMD\amfrt64.dll")
                }

                For Each p As String In amdPaths
                    If File.Exists(p) Then
                        _hasAMD = True
                        Debug.WriteLine("AMD detected via DLL: " & p)
                        Exit For
                    End If
                Next
            End If

        Catch ex As Exception
            Debug.WriteLine("DetectHardwareViaDLL Error: " & ex.Message)
        End Try
    End Sub

    Public Shared Function IsNvidiaAvailable() As Boolean
        Return _hasNvidia
    End Function

    Public Shared Function IsIntelAvailable() As Boolean
        Return _hasIntel
    End Function

    Public Shared Function IsAMDAvailable() As Boolean
