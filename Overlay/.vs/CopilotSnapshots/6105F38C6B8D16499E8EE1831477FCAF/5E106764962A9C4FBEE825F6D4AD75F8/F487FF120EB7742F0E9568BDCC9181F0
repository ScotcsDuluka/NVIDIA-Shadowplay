        ' FIX #8: Wrap settings save in try-catch
        Try
            My.Settings.ReplayDuration = seconds
            My.Settings.Save()
        Catch ex As Exception
            Debug.WriteLine("Failed to save replay duration: " & ex.Message)
        End Try

        Try
            Dim recorder As ScreenRecorder = RecorderInstance
            If recorder IsNot Nothing Then
                recorder.BufferDurationSeconds = seconds
