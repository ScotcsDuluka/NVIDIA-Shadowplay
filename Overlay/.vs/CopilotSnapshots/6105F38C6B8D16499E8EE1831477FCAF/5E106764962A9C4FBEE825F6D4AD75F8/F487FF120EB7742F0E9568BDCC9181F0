    Public Shared Function GetConfiguredRecorder() As ScreenRecorder
        PopulateEncoderDictionary()
        ApplySettingsToRecorder()
        ' FIX #7: Lazy(Of T).Value will never be Nothing, so just return directly
        Return _recorder.Value
    End Function

    Private Shared Sub PopulateEncoderDictionary()
        Dim needsPopulate As Boolean = False

        ' Check inside lock
        SyncLock _lockObj
            If _encoderDict.Count = 0 Then needsPopulate = True
            If _hasNvidia AndAlso Not _encoderDict.ContainsKey("NVENC_H264") Then needsPopulate = True
            If _hasIntel AndAlso Not _encoderDict.ContainsKey("QuickSync_H264") Then needsPopulate = True
            If _hasAMD AndAlso Not _encoderDict.ContainsKey("AMF_H264") Then needsPopulate = True

            If Not needsPopulate Then Exit Sub

            _encoderDict.Clear()
            If _cmbEncoderRef IsNot Nothing Then
                _cmbEncoderRef.Items.Clear()
            End If

            Dim addEncoder As Action(Of String, ScreenRecorder.VideoEncoder) =
                Sub(name, enc)
                    If Not _encoderDict.ContainsKey(name) Then
                        _encoderDict.Add(name, enc)
                        If _cmbEncoderRef IsNot Nothing Then
                            _cmbEncoderRef.Items.Add(name)
                        End If
                        Debug.WriteLine("Added encoder: " & name)
                    End If
                End Sub

            If _hasNvidia Then
                addEncoder("NVENC_H264", ScreenRecorder.VideoEncoder.NVENC_H264)
                addEncoder("NVENC_HEVC", ScreenRecorder.VideoEncoder.NVENC_HEVC)
                addEncoder("NVENC_AV1", ScreenRecorder.VideoEncoder.NVENC_AV1)
            End If

            If _hasIntel Then
                addEncoder("QuickSync_H264", ScreenRecorder.VideoEncoder.QuickSync_H264)
                addEncoder("QuickSync_HEVC", ScreenRecorder.VideoEncoder.QuickSync_HEVC)
            End If

            If _hasAMD Then
                addEncoder("AMF_H264", ScreenRecorder.VideoEncoder.AMF_H264)
                addEncoder("AMF_HEVC", ScreenRecorder.VideoEncoder.AMF_HEVC)
            End If

            addEncoder("LibX264", ScreenRecorder.VideoEncoder.LibX264)
            addEncoder("LibX265", ScreenRecorder.VideoEncoder.LibX265)

            _encoderDictPopulated = True

            Debug.WriteLine(String.Format("Encoder dictionary populated: NVIDIA={0}, Intel={1}, AMD={2}, Total={3}",
                _hasNvidia, _hasIntel, _hasAMD, _encoderDict.Count))
        End SyncLock
    End Sub

    Public Shared Sub ApplySettingsToRecorder()
        Try
            PopulateEncoderDictionary()

            ' FIX #7: Lazy(Of T).Value will never be Nothing, no need to check
            Dim recorder As ScreenRecorder = _recorder.Value

            Dim encoderApplied As Boolean = False

            ' Read _encoderDict in lock to prevent race condition
            Dim targetEncoder As ScreenRecorder.VideoEncoder = ScreenRecorder.VideoEncoder.LibX264
            Dim encoderFound As Boolean = False

            SyncLock _lockObj
                If _encoderDict.Count > 0 AndAlso Not String.IsNullOrEmpty(My.Settings.EncoderNOW) Then
                    If _encoderDict.ContainsKey(My.Settings.EncoderNOW) Then
                        targetEncoder = _encoderDict(My.Settings.EncoderNOW)
                        encoderFound = True
                    End If
                End If
            End SyncLock

            If encoderFound Then
                recorder.Encoder = targetEncoder
                encoderApplied = True
                Debug.WriteLine("ApplySettingsToRecorder: Encoder set to " & My.Settings.EncoderNOW)
            Else
                Debug.WriteLine("Encoder '" & My.Settings.EncoderNOW & "' not found, selecting best available")
            End If

            If Not encoderApplied Then
                SelectBestAvailableEncoder(recorder)
            End If

            ' FIX #11: Use constants instead of magic strings
            Select Case My.Settings.PresetNOW
                Case ScreenRecorder.PresetNames.Low
                    recorder.Preset = ScreenRecorder.RecordingPreset.Low
                Case ScreenRecorder.PresetNames.Medium
                    recorder.Preset = ScreenRecorder.RecordingPreset.Medium
                Case ScreenRecorder.PresetNames.High
                    recorder.Preset = ScreenRecorder.RecordingPreset.High
                Case ScreenRecorder.PresetNames.Custom
                    recorder.SetCustomSettings(
                        My.Settings.Custom_Width,
                        My.Settings.Custom_Height,
                        My.Settings.Custom_Bitrate,
                        My.Settings.Custom_FPS,
                        My.Settings.Custom_P
                    )
            End Select

            Debug.WriteLine(String.Format("Settings applied: Encoder={0}, Preset={1}, Resolution={2}x{3}, FPS={4}, Bitrate={5}",
                recorder.Encoder.ToString(), My.Settings.PresetNOW, recorder.ResolutionWidth, recorder.ResolutionHeight,
                recorder.Framerate, recorder.Bitrate))

        Catch ex As Exception
            Debug.WriteLine("ApplySettingsToRecorder Error: " & ex.Message)
        End Try
    End Sub

    Private Shared Sub SelectBestAvailableEncoder(recorder As ScreenRecorder)
        Dim selectedName As String = ""

        If _hasNvidia Then
            recorder.Encoder = ScreenRecorder.VideoEncoder.NVENC_H264
            selectedName = "NVENC_H264"
        ElseIf _hasAMD Then
            recorder.Encoder = ScreenRecorder.VideoEncoder.AMF_H264
            selectedName = "AMF_H264"
        ElseIf _hasIntel Then
            recorder.Encoder = ScreenRecorder.VideoEncoder.QuickSync_H264
            selectedName = "QuickSync_H264"
        Else
            recorder.Encoder = ScreenRecorder.VideoEncoder.LibX264
            selectedName = "LibX264"
        End If

        ' FIX #8: Wrap settings save in try-catch
        Try
            My.Settings.EncoderNOW = selectedName
            My.Settings.Save()
        Catch ex As Exception
            Debug.WriteLine("Failed to save encoder setting: " & ex.Message)
        End Try

        If _cmbEncoderRef IsNot Nothing AndAlso _cmbEncoderRef.Items.Contains(selectedName) Then
            _cmbEncoderRef.SelectedIndex = _cmbEncoderRef.Items.IndexOf(selectedName)
        End If

        Debug.WriteLine("Selected best encoder: " & selectedName)
    End Sub
