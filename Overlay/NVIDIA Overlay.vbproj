        <ItemGroup>
                <Folder Include="Resources\" />
        </ItemGroup>

        <ItemGroup>
                <ProjectReference Include="..\API\NVIDIA API.vbproj" />
                <ProjectReference Include="..\App Experience\NVIDIA Experience.vbproj" />
                <ProjectReference Include="..\CaptureEngine\CaptureEngine.vbproj" />
                <ProjectReference Include="..\Engine\NVIDIA Capture.vbproj" />
                <ProjectReference Include="..\Notifier\NVIDIA Notifier.vbproj" />
        </ItemGroup>

        <ProjectExtensions>
                <VisualStudio>
                        <UserProperties />
                </VisualStudio>
        </ProjectExtensions>

        <Target Name="PostBuild" AfterTargets="PostBuildEvent">
                <Exec Command="rm -f $(TargetDir)*.pdb $(TargetDir)*.xml $(TargetDir)*.deps.json" Condition=" '$(OS)' != 'Windows_NT'" />
                <Exec Command="del &quot;$(TargetDir)*.pdb&quot;&#xD;&#xA;del &quot;$(TargetDir)*.xml&quot;&#xD;&#xA;del &quot;$(TargetDir)*.deps.json&quot;" Condition=" '$(OS)' == 'Windows_NT'" />
        </Target>

</Project>