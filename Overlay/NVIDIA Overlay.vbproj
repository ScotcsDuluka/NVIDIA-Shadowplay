<Project Sdk="Microsoft.NET.Sdk">

        <PropertyGroup>
                <OutputType>WinExe</OutputType>
                <RootNamespace>NVIDIA_Share</RootNamespace>
                <UseWindowsForms>True</UseWindowsForms>
                <MyType>WindowsForms</MyType>
                <GeneratePackageOnBuild>False</GeneratePackageOnBuild>
                <PackageId></PackageId>
                <Title>NVIDIA ShadowPlay by ScotcsDuluka</Title>
                <Company>Duluka Corporation</Company>
                <Authors>ScotcsDuluka</Authors>
                <Product>NVIDIA ShadowPlay</Product>
                <Description>NVIDIA ShadowPlay for All Users</Description>
                <PackageIcon></PackageIcon>
                <Copyright>Copyright© by Scotcs Duluka</Copyright>
                <NeutralLanguage>en-US</NeutralLanguage>
                <TargetFramework>net8.0-windows10.0.26100.0</TargetFramework>
                <PackageReadmeFile></PackageReadmeFile>
                <Platforms>AnyCPU;x64</Platforms>
                <ApplicationIcon>NVIDIA ShadowPlay.ico</ApplicationIcon>
                <ApplicationManifest>My Project\app.manifest</ApplicationManifest>
                <IncludeSymbols>False</IncludeSymbols>
                <SymbolPackageFormat>snupkg</SymbolPackageFormat>
                <GenerateDocumentationFile>False</GenerateDocumentationFile>
                <AnalysisLevel>6.0-minimum</AnalysisLevel>
                <EnableNETAnalyzers>True</EnableNETAnalyzers>
                <UseWPF>False</UseWPF>
                <EnforceCodeStyleInBuild>False</EnforceCodeStyleInBuild>
                <StartupObject>NVIDIA_Share.My.MyApplication</StartupObject>
                <SupportedOSPlatformVersion>10.0.26100.0</SupportedOSPlatformVersion>
                <AssemblyName>NVIDIA ShadowPlay</AssemblyName>
                <RunAnalyzersDuringBuild>False</RunAnalyzersDuringBuild>
                <RunAnalyzersDuringLiveAnalysis>False</RunAnalyzersDuringLiveAnalysis>
                <Configurations>Release;Debug</Configurations>
                <OptionExplicit>Off</OptionExplicit>
                <OptionInfer>Off</OptionInfer>
                <RunPostBuildEvent>Always</RunPostBuildEvent>
                <PackAsTool>False</PackAsTool>
                <NuGetAudit>True</NuGetAudit>
                <AppDesignerFolder>My Project</AppDesignerFolder>
        </PropertyGroup>

<Target Name="IncrementBuild" BeforeTargets="BeforeBuild">

  <WriteLinesToFile File="$(MSBuildProjectDirectory)\build.txt" Lines="100" Overwrite="false" Condition="!Exists('$(MSBuildProjectDirectory)\build.txt')" />

<Exec Command="bash $(MSBuildProjectDirectory)/inc_build.sh $(MSBuildProjectDirectory)/build.txt" Condition=" '$(OS)' != 'Windows_NT'" />
<Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -Command &quot;$f='$(MSBuildProjectDirectory)\build.txt'; $n=[int](Get-Content $f -Raw).Trim(); Set-Content $f ($n+1)&quot;" Condition=" '$(OS)' == 'Windows_NT'" />

  <ReadLinesFromFile File="$(MSBuildProjectDirectory)\build.txt">
    <Output TaskParameter="Lines" PropertyName="BuildNumber" />
  </ReadLinesFromFile>

  <PropertyGroup>
    <Version>3.3.$(BuildNumber).30</Version>
    <AssemblyVersion>3.3.$(BuildNumber).30</AssemblyVersion>
    <FileVersion>3.3.$(BuildNumber).30</FileVersion>
  </PropertyGroup>

</Target>

        <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
                <RegisterForComInterop>False</RegisterForComInterop>
                <DefineDebug>False</DefineDebug>
                <OutputPath>bin\$(Configuration)\</OutputPath>
                <RemoveIntegerChecks>True</RemoveIntegerChecks>
                <NoWarn>41998,41999,42004,42016,42017,42018,42019,42020,42021,42022,42024,42025,42026,42029,42030,42031,42032,42036,42099,42104,42105,42106,42107,42108,42109,42353,42354,42355</NoWarn>
                <WarningsAsErrors>42025</WarningsAsErrors>
                <DebugType>none</DebugType>
                <GenerateSerializationAssemblies>Off</GenerateSerializationAssemblies>
                <WarningLevel>0</WarningLevel>
        </PropertyGroup>

        <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
          <RegisterForComInterop>False</RegisterForComInterop>
          <DefineDebug>False</DefineDebug>
          <OutputPath>bin\$(Configuration)\</OutputPath>
          <RemoveIntegerChecks>True</RemoveIntegerChecks>
          <NoWarn>41998,41999,42004,42016,42017,42018,42019,42020,42021,42022,42024,42025,42026,42029,42030,42031,42032,42036,42099,42104,42105,42106,42107,42108,42109,42353,42354,42355</NoWarn>
          <WarningsAsErrors>42025</WarningsAsErrors>
          <DebugType>none</DebugType>
          <GenerateSerializationAssemblies>Off</GenerateSerializationAssemblies>
          <WarningLevel>0</WarningLevel>
        </PropertyGroup>

        <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
                <DebugType>none</DebugType>
        </PropertyGroup>

        <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
          <DebugType>none</DebugType>
        </PropertyGroup>

        <ItemGroup>
          <Compile Remove="[Forms Overlay - Project Files]\[UI OVERLAY]\[Notifier]\**" />
          <EmbeddedResource Remove="[Forms Overlay - Project Files]\[UI OVERLAY]\[Notifier]\**" />
          <None Remove="[Forms Overlay - Project Files]\[UI OVERLAY]\[Notifier]\**" />
        </ItemGroup>

        <!-- COMReference removed for Linux cross-build: WMPLib -->

        <ItemGroup>
                <Content Include="NVIDIA ShadowPlay.ico" />
        </ItemGroup>

        <ItemGroup>
                <Import Include="System" />
                <Import Include="System.Collections" />
                <Import Include="System.Collections.Generic" />
                <Import Include="System.Data" />
                <Import Include="System.Diagnostics" />
                <Import Include="System.Drawing" />
                <Import Include="System.Linq" />
                <Import Include="System.Threading.Tasks" />
                <Import Include="System.Windows.Forms" />
                <Import Include="System.Xml.Linq" />
                <Import Include="Microsoft.VisualBasic" />
        </ItemGroup>

        <ItemGroup>
                <PackageReference Include="Microsoft.AspNetCore.Components.WebView" Version="10.0.5" />
                <PackageReference Include="NAudio.Core" Version="2.3.0" />
                <PackageReference Include="NAudio.Wasapi" Version="2.3.0" />
                <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
                <PackageReference Include="System.CodeDom" Version="10.0.5" />
                <PackageReference Include="System.Management" Version="10.0.5" />
                <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="9.0.0" />
        </ItemGroup>

        <ItemGroup>
                <Compile Update="My Project\Application.Designer.vb">
                        <DesignTime>True</DesignTime>
                        <AutoGen>True</AutoGen>
                        <DependentUpon>Application.myapp</DependentUpon>
                </Compile>
                <Compile Update="My Project\Resources.Designer.vb">
                        <DesignTime>True</DesignTime>
                        <AutoGen>True</AutoGen>
                        <DependentUpon>Resources.resx</DependentUpon>
                </Compile>
                <Compile Update="My Project\Settings.Designer.vb">
                        <DesignTimeSharedInput>True</DesignTimeSharedInput>
                        <AutoGen>True</AutoGen>
                        <DependentUpon>Settings.settings</DependentUpon>
                </Compile>
                <Compile Update="[Forms Overlay - Project Files]\[API]\[Helpers]\BlockClose.vb">
                        <SubType>Form</SubType>
                </Compile>
                <Compile Update="[Forms Overlay - Project Files]\[UI OVERLAY]\[index]\[Base]\Shadow\s1.vb" />
                <Compile Update="[Forms Overlay - Project Files]\[UI OVERLAY]\[index]\[Base]\Shadow\s4.vb">
                  <SubType>Form</SubType>
                </Compile>
                <Compile Update="[Forms Overlay - Project Files]\[UI OVERLAY]\[index]\[Base]\Shadow\s3.vb" />
                <Compile Update="[Forms Overlay - Project Files]\[UI OVERLAY]\[index]\[Base]\Shadow\s2.vb">
                  <SubType>Form</SubType>
                </Compile>
        </ItemGroup>

        <ItemGroup>
                <EmbeddedResource Update="My Project\Resources.resx">
                        <CustomToolNamespace>My.Resources</CustomToolNamespace>
                        <Generator>VbMyResourcesResXFileCodeGenerator</Generator>
                        <LastGenOutput>Resources.Designer.vb</LastGenOutput>
                </EmbeddedResource>
        </ItemGroup>

        <ItemGroup>
                <None Update="API-Core\avcodec-62.dll">
