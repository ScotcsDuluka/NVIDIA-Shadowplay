<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <!-- ============================================================================
       BL-1 C++ lane (imported explicitly by the CEF host vcxproj — vcxproj
       never auto-imports Directory.Build.props/targets; that auto-import
       lives in Microsoft.Common.props/targets which C++ does not use).

       The CEF host projects (NVIDIA Share, Launcher + their bootstraps)
       carry their product version in a hand-stamped src/version.rc. This
       file regenerates src/bl1_version.h next to it before ResourceCompile
       with the SAME contract as the .NET lane (Directory.Build.targets
       _Bl1Stamp): HardcoreVersion (version.props, $build = counter) >
       default 3.41.<N>.61. The hand-stamped defines in version.rc stay as
       fallback; the generated header #undef + redefines them.
       Opt-in per project: <Bl1CppVersionPrefix>SHARE</Bl1CppVersionPrefix>.
       Regenerated every build on purpose: the counter changes per build.
       ============================================================================ -->

  <PropertyGroup>
    <HardcoreVersion Condition="'$(HardcoreVersion)' == ''"></HardcoreVersion>
  </PropertyGroup>
  <Import Project="$(MSBuildThisFileDirectory)version.props"
          Condition="Exists('$(MSBuildThisFileDirectory)version.props')" />

  <Target Name="_Bl1CppStamp"
          BeforeTargets="BeforeBuild;ResourceCompile"
          Condition="'$(Bl1CppVersionPrefix)' != ''">
    <PropertyGroup>
      <_Bl1CppN Condition="Exists('$(MSBuildThisFileDirectory)build.txt')">$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)build.txt').Trim())</_Bl1CppN>
      <_Bl1CppN Condition="'$(_Bl1CppN)' == ''">0</_Bl1CppN>
      <_Bl1CppV Condition="'$(HardcoreVersion)' != ''">$([System.Text.RegularExpressions.Regex]::Replace('$(HardcoreVersion)', '\$build', '$(_Bl1CppN)'))</_Bl1CppV>
      <_Bl1CppV Condition="'$(HardcoreVersion)' == ''">3.41.$(_Bl1CppN).61</_Bl1CppV>
    </PropertyGroup>
    <WriteLinesToFile File="$(MSBuildProjectDirectory)\src\bl1_version.h"
                      Overwrite="true"
                      Encoding="ASCII"
                      Lines="/* GENERATED by Build/Build-Config/bl1-cpp.targets - do not edit. */;#undef $(Bl1CppVersionPrefix)_FILEVERSION;#undef $(Bl1CppVersionPrefix)_FILEVERSION_STR;#define $(Bl1CppVersionPrefix)_FILEVERSION $(_Bl1CppV.Replace('.', ','));#define $(Bl1CppVersionPrefix)_FILEVERSION_STR &quot;$(_Bl1CppV)\0&quot;" />
    <Message Text="BL-1 C++ stamp: $(_Bl1CppV) -> $(MSBuildProjectName)/src/bl1_version.h"
             Importance="low" />
  </Target>

</Project>
