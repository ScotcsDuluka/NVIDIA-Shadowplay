<Project>

  <!-- ============================================================================
       Directory.Build.targets — owner-tree build support.
       The canonical product layout is produced by
       deploy/deploy-shadowplay-layout.ps1. Plain Overlay builds invoke that
       same owner-layout producer for the dev bin; scripts/layout.proj invokes
       it explicitly for the dist tree. Retired Services/Application/WebView
       owners are not produced by these targets.
       ============================================================================ -->
<!-- ── Dev-bin owner-tree completion: a plain build leaves a runnable product ──
       Overlay\bin\<cfg>\<tfm>\ is kept aligned with the current owner
       tree. Runtime-created NvConfig\ is seeded from proven Notifier config
       files; Data\ retains the expected runtime payload. -->
  <Target Name="_DevLayoutComplete"
          AfterTargets="Build"
          Condition="'$(StageLayout)' != 'true' And '$(AssemblyName)' == 'NVIDIA ShadowPlay' And '$(MSBuildProjectName)' == 'NVIDIA Overlay'">
    <MakeDir Directories="$(TargetDir)Flags;$(TargetDir)Logs;$(TargetDir)Data;$(TargetDir)NvConfig" />
    <ItemGroup>
      <_DevDataFiles Include="$(MSBuildThisFileDirectory)Overlay\NVIDIA_Shadowplay_Data\**\*" />
      <_DevConfigFiles Include="$(MSBuildThisFileDirectory)NvNotifier\notifier_obs.json" />
      <_DevConfigFiles Include="$(MSBuildThisFileDirectory)NvNotifier\notifier_obs.example.json"
                       Condition="Exists('$(MSBuildThisFileDirectory)NvNotifier\notifier_obs.example.json')" />
    </ItemGroup>
    <Copy SourceFiles="@(_DevDataFiles)"
          DestinationFiles="@(_DevDataFiles->'$(TargetDir)Data\NVIDIA_Shadowplay_Data\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_DevConfigFiles)"
          DestinationFiles="@(_DevConfigFiles->'$(TargetDir)NvConfig\%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
    <Message Text="dev layout complete -> $(TargetDir)" Importance="high" />
  </Target>
  <!-- The final owner tree is produced only by scripts/layout.proj and deploy-shadowplay-layout.ps1. Plain Overlay builds keep standard SDK output as the staging source. -->

    <!-- Normal builds stage the authoritative owner tree through the single
       deploy-shadowplay-layout.ps1 implementation. --><!-- The final owner tree is produced only by scripts/layout.proj -> deploy-shadowplay-layout.ps1. Plain Overlay builds keep standard SDK output as the staging source. -->
<!-- ============================================================================
       BL-1 Release traceability stamping (C/3). Runs BEFORE compile in every
       project: resolves the git commit once per build (cached in
       obj/bl1-commit.txt for the non-Windows path), reads the authoritative
       build number from Overlay/build.txt (after Overlay's IncrementBuild
       target refreshed it), and applies the product version contract:

         FileVersion / ProductVersion = 3.41.<BuildNumber>.61
         InformationalVersion         = 3.41.<BuildNumber>.61+<git-sha>

       AssemblyVersion is deliberately NOT overridden (assembly identity /
       binding semantics stay historical). IncrementBuild (Overlay.vbproj)
       re-sets FileVersion/InformationalVersion for Overlay itself with the
       SAME scheme, so both paths converge on one number.
       ============================================================================ -->
  <Target Name="_Bl1Stamp" BeforeTargets="BeforeBuild;BeforeCompile">

    <!-- 1. git commit — resolve once per build. Windows uses Exec+redirect
         (MSBuild property functions cannot run processes); the bash path
         covers Linux CI. Fails soft outside a git worktree. -->
    <!-- BL-1 (race fix): capture the sha via ConsoleToMsBuild output —
         no shared file, no cross-process read/write races between the N
         parallel project builds. GitShaFile is kept ONLY as the installer
         provenance file, written once per project from the captured value. -->
    <Exec Command="git rev-parse HEAD"
          IgnoreExitCode="true"
          ConsoleToMsBuild="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="Bl1GitShaRaw" />
    </Exec>
    <PropertyGroup>
      <Bl1GitSha Condition="'$(Bl1GitShaRaw)' != ''">$(Bl1GitShaRaw.Trim())</Bl1GitSha>
      <Bl1GitSha Condition="'$(Bl1GitSha)' == '' And Exists('$(GitShaFile)')">$([System.IO.File]::ReadAllText($(GitShaFile)).Trim())</Bl1GitSha>
      <!-- Missing-git fail-soft: a redirect target may exist as a 0-byte
           file when git is absent — an empty sha must behave like no sha
           (all-zero placeholder keeps the version shape parseable). -->
      <Bl1GitSha Condition="'$(Bl1GitSha)' == ''">0000000000000000000000000000000000000000</Bl1GitSha>
    </PropertyGroup>

    <!-- 2. authoritative build number (Overlay/build.txt) -->
    <PropertyGroup Condition="Exists('$(SharedBuildNumberFile)')">
      <SharedBuildNumber>$([System.IO.File]::ReadAllText($(SharedBuildNumberFile)).Trim())</SharedBuildNumber>
    </PropertyGroup>
    <PropertyGroup Condition="'$(SharedBuildNumber)' == ''">
      <SharedBuildNumber>0</SharedBuildNumber>
    </PropertyGroup>

    <PropertyGroup>
      <_Bl1Version>3.41.$(SharedBuildNumber).61</_Bl1Version>
      <_Bl1InfoVersion>$(_Bl1Version)</_Bl1InfoVersion>
      <!-- Contract application: only where a project didn't set its own.
           Overlay's IncrementBuild re-sets FileVersion/InformationalVersion
           with the same scheme AFTER this target (BeforeBuild ordering:
           Directory.Build.targets runs before project targets), so both
           converge. -->
      <FileVersion Condition="'$(FileVersion)' == ''">$(_Bl1Version)</FileVersion>
      <InformationalVersion Condition="'$(InformationalVersion)' == ''">$(_Bl1Version)</InformationalVersion>
      <!-- Feed the SDK's AddSourceRevisionToInformationalVersion with OUR
           resolved sha (it appends '+<sha>' itself when the version has no
           '+' — SemVer 2.0 path). Deterministic even if the SDK's own
           source-control discovery fails. -->
      <SourceRevisionId Condition="'$(Bl1GitSha)' != ''">$(Bl1GitSha)</SourceRevisionId>
    </PropertyGroup>

    <Message Text="BL-1 stamp: v=$(_Bl1Version) sha=$(Bl1GitSha) (assembly=$(MSBuildProjectName))"
             Importance="low" />
  </Target>

  <!-- ============================================================================
       StampTestProvenance (C/4 parallel-build contamination audit).
       Every *Tests assembly carries its build identity:
         AssemblyMetadata "BuildUtc"        — when the binary was produced
         AssemblyMetadata "SourceRevision"  — git short HEAD (best-effort;
                                              "unknown (git unavailable)"
                                              when git is not on PATH)
       Suites print this at startup, so a reported proof is tied to the
       binary that produced it. A run that skips the build step against a
       stale or other-agent-contaminated binary can no longer be silently
       attributed to the current source. Production assemblies are
       deliberately NOT stamped (zero runtime impact). Same source still
       compiles byte-deterministically apart from this metadata (verified
       by SHA-256 comparison during the audit).
       ============================================================================ -->
  <Target Name="StampTestProvenance" BeforeTargets="BeforeBuild"
          Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('$(AssemblyName)', '(Tests)$'))">
    <PropertyGroup>
      <_ProvBuildUtc>$([System.DateTime]::UtcNow.ToString("yyyy-MM-ddTHH:mm:ssZ"))</_ProvBuildUtc>
      <_ProvGitRevRaw></_ProvGitRevRaw>
    </PropertyGroup>
    <Exec Command="git rev-parse --short HEAD" ConsoleToMsBuild="true" IgnoreExitCode="true"
          IgnoreStandardErrorWarningFormat="true" StandardOutputImportance="low" StandardErrorImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="_ProvGitRevRaw" />
    </Exec>
    <PropertyGroup>
      <!-- Sanitizer: accept ONLY a hex short-hash. When git is unavailable
           the Exec output may contain shell error text ("'git' is not
           recognized...") — that must never leak into the stamp. -->
      <_ProvSourceRev Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('$(_ProvGitRevRaw.Trim())', '^[0-9a-f]{7,40}$'))">$(_ProvGitRevRaw.Trim())</_ProvSourceRev>
      <_ProvSourceRev Condition="'$(_ProvSourceRev)' == ''">unknown (git unavailable)</_ProvSourceRev>
    </PropertyGroup>
    <ItemGroup>
      <AssemblyMetadata Include="BuildUtc" Value="$(_ProvBuildUtc)" />
      <AssemblyMetadata Include="SourceRevision" Value="$(_ProvSourceRev)" />
    </ItemGroup>
  </Target>
</Project>
