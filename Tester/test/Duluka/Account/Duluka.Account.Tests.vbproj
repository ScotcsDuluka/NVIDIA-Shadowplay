<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace></RootNamespace>
    <TargetFramework>net10.0</TargetFramework>
    <OptionStrict>On</OptionStrict>
    <OptionExplicit>On</OptionExplicit>
    <OptionInfer>On</OptionInfer>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>Duluka.Account.Tests</AssemblyName>
    <Description>Duluka v0.1 account/sync contract tests — executable spec for account creation, provider uniqueness, last-provider unlink, session expiry/revoke, device-revoke cascade, If-Match sync races and the 401/403/409 contract. Deterministic (injected clock, in-memory reference adapter); the HTTP probe harness activates only when DULUKA_BASE_URL is set. No GPU, no NVENC.</Description>
  </PropertyGroup>

</Project>