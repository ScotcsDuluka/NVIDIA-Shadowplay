<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace></RootNamespace>
    <TargetFramework>net8.0</TargetFramework>
    <OptionStrict>On</OptionStrict>
    <OptionExplicit>On</OptionExplicit>
    <OptionInfer>On</OptionInfer>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <AssemblyName>CaptureEngine.Video.Ddagrab</AssemblyName>
    <Description>CaptureEngine.Video.Ddagrab — DdagrabBackend skeleton (GLM-1; lifecycle only, no real capture yet)</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CaptureEngine.Video\CaptureEngine.Video.vbproj" />
    <ProjectReference Include="..\CaptureEngine\CaptureEngine.vbproj" />
  </ItemGroup>

</Project>
